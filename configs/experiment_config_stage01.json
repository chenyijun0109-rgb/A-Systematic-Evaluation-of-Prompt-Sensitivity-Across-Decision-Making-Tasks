{
  "config_name": "experiment_config_stage01",
  "version": "0.7",
  "status": "frozen_for_validation_rerun",
  "created_date": "2026-05-28",
  "description": "Stage 01 experiment configuration for three cognitive decision-making tasks under four prompt conditions, with English, Simplified Chinese, and Spanish prompt versions.",
  "prompt_languages": [
    "en",
    "zh-CN",
    "es"
  ],
  "default_prompt_language": "en",
  "global_settings": {
    "model_name": "gpt-4.1-2025-04-14",
    "temperature": 0.7,
    "top_p": 1.0,
    "max_tokens": 16,
    "runs_per_condition": {
      "target": 20,
      "minimum_valid": 15,
      "optional_extension": "30-50"

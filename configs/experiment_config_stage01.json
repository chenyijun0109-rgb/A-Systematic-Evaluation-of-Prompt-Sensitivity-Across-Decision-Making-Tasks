      "metrics": [
        "net_score",
        "advantageous_choice_rate",
        "deck_preference",
        "block_wise_learning_curve",
        "average_net_outcome",
        "post_loss_switching"
      ],
      "human_dataset": {
        "path": "DATASET/IGT/IGTdataSteingroever2014",
        "primary_files": [
          "choice_100.csv",
          "wi_100.csv",
          "lo_100.csv",
          "index_100.csv"
        ],
        "alignment_notes": "Use the 100-trial subset for the main human comparison."
      },
      "citation_basis": [
        "Bechara et al. (1994)",
        "Steingroever et al. (2015)"
      ]
    },
    "bart": {
      "display_name": "Balloon Analogue Risk Task",
      "cognitive_focus": "risk_taking_under_potential_reward_and_loss",
      "prompt_conditions": [
        "baseline",
        "detailed",
        "role_human",
        "risk_emphasis"
      ],
      "prompt_paths": {
        "baseline": "prompts/bart/baseline.md",
        "detailed": "prompts/bart/detailed.md",
        "role_human": "prompts/bart/role_human.md",
        "risk_emphasis": "prompts/bart/risk_emphasis.md",
        "task_named_baseline": "prompts/bart/baseline_task_named.md"
      },
      "multilingual_prompt_paths": {
        "zh-CN": {
          "baseline": "prompts/multilingual/zh-CN/bart/baseline.md",
          "detailed": "prompts/multilingual/zh-CN/bart/detailed.md",
          "role_human": "prompts/multilingual/zh-CN/bart/role_human.md",
          "risk_emphasis": "prompts/multilingual/zh-CN/bart/risk_emphasis.md"
        },
        "es": {
          "baseline": "prompts/multilingual/es/bart/baseline.md",
          "detailed": "prompts/multilingual/es/bart/detailed.md",
          "role_human": "prompts/multilingual/es/bart/role_human.md",
          "risk_emphasis": "prompts/multilingual/es/bart/risk_emphasis.md"
        }
      },
      "response_format": {
        "valid_outputs": [
          "ACTION: PUMP",
          "ACTION: CASH_OUT"
        ],
        "parser_pattern": "^ACTION:\\s*(PUMP|CASH_OUT)\\s*$"
      },
      "parameters": {
        "n_balloons": 40,
        "block_structure": {
          "n_blocks": 2,
          "balloons_per_block": 20
        },
        "practice_balloons": 0,
        "pump_reward": 0.05,
        "actions": [
          "PUMP",
          "CASH_OUT"
        ],
        "temporary_earning_formula": "pump_count * pump_reward",
        "cash_out_rule": "add_temporary_earning_to_total_and_end_balloon",
        "explosion_rule": {
          "type": "increasing_probability",
          "probability_by_pump": "pump k explodes with probability 1/(33-k), for k=1..32",
          "certain_explosion_pump": 32,
          "hide_exact_probability_from_model": true
        }
      },
      "metrics": [
        "average_pumps",
        "adjusted_average_pumps",
        "explosion_rate",
        "average_earning_per_balloon",
        "post_explosion_adjustment"
      ],
      "human_dataset": {
        "path": "DATASET/BART/Dataset.xlsx",
        "source_participants": 147,
        "minimum_age": 18,
        "excluded_participant_ids": [
          4,
          5,
          7,
          13,
          79,
          86
        ],
        "analysis_participants": 141,
        "exclusion_audit_path": "outputs/processed/human_metrics/bart_exclusions.csv",
        "alignment_notes": "The raw file has 5880 rows (147 participants x 40 balloons). Age is stored at zero-based column index 8. Filtering age >= 18 retains 141 adults and 5640 rows. Reward and earning columns may be transformed or scaled."
      },
      "citation_basis": [
        "Lejuez et al. (2002)",
        "Sebri et al. (2023)"
      ]
    }

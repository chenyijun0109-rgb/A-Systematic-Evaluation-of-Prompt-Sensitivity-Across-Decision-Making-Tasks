  "output_paths": {
    "raw_llm_outputs": "outputs/raw",
    "trial_level_data": "outputs/processed/trial_level",
    "run_level_metrics": "outputs/processed/run_level",
    "invalid_response_logs": "outputs/processed/invalid_responses",
    "figures": "outputs/figures",
    "tables": "outputs/tables"
  },
  "analysis": {
    "baseline_condition": "baseline",
    "prompt_sensitivity": {
      "standardised_effect_formula": "Hedges_g = J * (mean(metric_condition) - mean(metric_baseline)) / pooled_sample_sd",
      "sensitivity_effect_formula": "(mean(metric_condition) - mean(metric_baseline)) / sd(metric_baseline)",
      "zero_variance_rule": "undefined_whenever_pooled_sd_is_zero; retain_raw_difference; flag_constant_equal_or_constant_unequal",
      "psi_formula": "mean(abs(standardised_effects_across_selected_metrics))",
      "bootstrap_unit_by_task": {
        "horizon": "paired_environment_seed; random_exploration_effect refits the hierarchical model within every bootstrap replicate",
        "igt": "independent_cell",
        "bart": "paired_environment_seed"
      },
      "primary_metrics": {
        "horizon": [
          "directed_exploration",
          "horizon_effect",
          "random_exploration_effect"
        ],
        "igt": [
          "advantageous_choice_rate",
          "post_loss_switching_rate"
        ],
        "bart": [
          "adjusted_average_pumps",
          "explosion_rate",
          "post_explosion_adjustment"
        ]
      },
      "supplementary_metrics": {
        "horizon": [
          "exploration_rate",
          "switching_rate",
          "average_reward_per_trial"
        ],
        "igt": [
          "learning_slope",
          "learning_curve_change",
          "block_wise_learning_curve"
        ],
        "bart": [
          "average_pumps",
          "average_earning_per_balloon"
        ]
      },
      "zero_tolerance": 1e-12,
      "minimum_partial_metrics": 2,
      "confidence_level": 0.95,
      "bootstrap_replicates": 2000,
      "bootstrap_seed": 20260615,
      "bootstrap_validity": {
        "formal_minimum": 0.95,
        "warning_minimum": 0.9,
        "below_warning_action": "withhold_interval"
      },
      "bounded_metrics": [
        "directed_exploration",
        "horizon_effect",
        "advantageous_choice_rate",
        "post_loss_switching_rate",
        "explosion_rate"
      ],
      "low_variance_absolute_threshold": 1e-6,
      "low_variance_relative_threshold": 1e-6
    },
    "language_sensitivity": {
      "reference_language": "en",
      "target_languages": [
        "zh-CN",
        "es"
      ],
      "allowed_source_configurations": {
        "en": [
          {
            "config_name": "experiment_config_stage01",
            "config_version": "0.5"
          }
        ],
        "zh-CN": [
          {
            "config_name": "experiment_config_stage01",
            "config_version": "0.7"
          }
        ],
        "es": [
          {
            "config_name": "experiment_config_stage01",
            "config_version": "0.7"
          }
        ]
      },
      "baseline_language_contrast": "target language minus English",
      "language_prompt_interaction": "(target condition - target baseline) - (English condition - English baseline)",
      "bootstrap_replicates": 2000,
      "bootstrap_seed": 20260615,
      "confidence_level": 0.95,
      "confidence_interval": "percentile",
      "bootstrap_units": {
        "horizon": "matched_seed_block",
        "igt": "independent_cell_run",
        "bart": "matched_seed_block"
      },
      "outputs": [
        "language_baseline_contrasts.csv",
        "language_prompt_interactions.csv",
        "language_interaction_summary.json"
      ]
    },
    "horizon_random_exploration": {
      "model": "hierarchical_logistic_map_fixed_gaussian_shrinkage",
      "run_estimate_type": "partially_pooled_model_derived",
      "refit_within_downstream_bootstrap": true,
      "run_effect_sd": 0.5,
      "shrinkage_sensitivity_grid": [
        0.25,
        0.5,
        1.0
      ],
      "bootstrap_unit": "run_cluster",
      "bootstrap_replicates": 2000,
      "confidence_level": 0.95,
      "minimum_formal_runs": 15,
      "target_runs": 20
    },
    "event_conditioned_missing_values": {
      "bart_post_explosion_adjustment": "missing_if_no_explosion_with_a_subsequent_balloon; never replace with zero"
    }
  }
